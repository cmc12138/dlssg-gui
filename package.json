{
  "name": "dlssg-gui",
  "version": "0.1.1",
  "private": true,
  "description": "DLSSG for SM86 图形化管理器：为 RTX 20/30 系显卡一键注入 DLSS 帧生成代理",
  "main": "./out/main/index.js",
  "license": "GPL-3.0-only",
  "author": "DLSSG GUI",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --import ./test/loader.mjs test/core.test.mts",
    "pack:win": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
